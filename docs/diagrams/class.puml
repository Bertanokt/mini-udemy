package "com.miniudemy.common.exception" as commonex {
  abstract class ApiException
  class BadRequestException
  class ConflictException
}

' ---- JPA ilişkileri (modül içi) ----
User --> "1" Role : role
PasswordResetToken ..> User : userId
PasswordResetService --> PasswordResetNotifier
LoggingPasswordResetNotifier ..|> PasswordResetNotifier
DisabledPasswordResetNotifier ..|> PasswordResetNotifier
Course "*" --> "1" Category : category
Course *-- "*" Section : sections
Section *-- "*" Lesson : lessons
Course --> "1" CourseLevel : level
Course --> "1" CourseStatus : status
Lesson --> "1" LessonContentType : contentType
Quiz *-- "*" QuizQuestion : questions
Quiz --> "1" ScoringType : scoringType
Question *-- "*" Option : options
QuizAttempt *-- "*" AttemptAnswer : answers
Notification --> "1" NotificationType : type
NotificationContent --> NotificationType
Complaint --> "1" ComplaintStatus : status

' ---- State (ayrıntı: class-state.puml) ----
CourseStatus --> "1" CourseState : state
CourseState <|.. DraftState
CourseState <|.. InReviewState
CourseState <|.. PublishedState
CourseState <|.. UnpublishedState
ConflictException <|-- CourseStateException
ApiException <|-- ConflictException
ApiException <|-- BadRequestException
CourseState ..> CourseStateException : <<throw>>
Course ..> BadRequestException : <<throw>>
Complaint ..> BadRequestException : <<throw>>

' ---- Factory Method (ayrıntı: class-factory.puml) ----
LessonContentFactory <|-- VideoContentFactory
LessonContentFactory <|-- PdfContentFactory
LessonContentFactory <|-- DocumentContentFactory
LessonContent <|-- VideoContent
LessonContent <|-- PdfContent
LessonContent <|-- DocumentContent
LessonContentFactories o--> LessonContentFactory
LessonContentFactory ..> LessonContent : <<create>>
StorageService <|.. LocalDiskStorageService

' ---- Strategy (ayrıntı: class-strategy.puml) ----
ScoringStrategy <|.. SingleAnswerScoring
ScoringStrategy <|.. MultiAnswerAllOrNothing
ScoringStrategy <|.. MultiAnswerPartialScoring
ScoringStrategyResolver o--> ScoringStrategy
QuizAttemptService --> ScoringStrategyResolver

' ---- Modül sınırında id referansları ----
Course ..> User : instructorId
Course ..> StoredFile : coverFileId
Lesson ..> StoredFile : contentFileId
StoredFile ..> User : uploaderId
Enrollment ..> User : studentId
Enrollment ..> Course : courseId
CourseProgress ..> Enrollment : enrollmentId
CourseProgress ..> Lesson : lastLessonId
LessonProgress ..> Enrollment : enrollmentId
LessonProgress ..> Lesson : lessonId
Quiz ..> Section : sectionId
Question ..> Course : courseId
QuizQuestion ..> Question : questionId
QuizAttempt ..> Quiz : quizId
QuizAttempt ..> User : studentId
Certificate ..> Enrollment : enrollmentId
Review ..> User : userId
Review ..> Course : courseId
Notification ..> User : userId
Complaint ..> User : reporterId
Complaint ..> User : resolvedById
Complaint ..> Course : courseId
Complaint ..> Review : reviewId

' ---- Modül arayüzü başka modülde uygulanır (bağımlılık tersine çevrilir) ----
CourseRoster <|.. EnrollmentRosterService
EnrollmentCounts <|.. EnrollmentStatsService
CourseProgressStats <|.. CourseProgressStatsService
CourseQuizStats <|.. QuizStatsService
CourseRatings <|.. ReviewStatsService
EnrollmentProgress <|.. EnrollmentProgressService

@enduml
