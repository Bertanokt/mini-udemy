' ================= quiz =================
package "com.miniudemy.quiz" as quiz {
  package "quiz.domain" {
    class Quiz <<entity>> {
      - id : Long
      - sectionId : Long
      - title : String
      - scoringType : ScoringType
      - passThreshold : int
      - required : boolean
      - createdAt : Instant
      - questions : List<QuizQuestion>
      + updateSettings(title : String, passThreshold : int, required : boolean) : void
      + changeScoringType(scoringType : ScoringType) : void
      + replaceQuestions(questionIds : List<Long>) : void
      + getQuestionIds() : List<Long>
    }
    class QuizQuestion <<embeddable>> {
      - questionId : Long
      - position : int
    }
    class Question <<entity>> {
      - id : Long
      - courseId : Long
      - text : String
      - points : int
      - createdAt : Instant
      - options : List<Option>
      + update(text : String, points : int) : void
      + replaceOptions(newOptions : List<Option>) : void
    }
    class Option <<entity>> {
      - id : Long
      - text : String
      - correct : boolean
    }
    class QuizAttempt <<entity>> {
      - id : Long
      - quizId : Long
      - studentId : Long
      - score : BigDecimal
      - maxScore : BigDecimal
      - passed : boolean
      - submittedAt : Instant
      - answers : List<AttemptAnswer>
      + getPercent() : BigDecimal
    }
    class AttemptAnswer <<embeddable>> {
      - questionId : Long
      - optionId : Long
    }
    class GradedQuestion <<record>> {
      questionId : Long
      earnedPoints : BigDecimal
      maxPoints : int
      + isCorrect() : boolean
    }
    enum ScoringType {
      SINGLE_ANSWER
      MULTI_ALL_OR_NOTHING
      MULTI_PARTIAL
    }
    class QuizCompleted <<event>>
  }
  package "quiz.service" {
    class QuizService
    class QuestionService
    class QuizAttemptService
    class QuizRequirementService
    class QuizStatsService
    class ScoringStrategyResolver
    interface ScoringStrategy <<Strategy>>
    class SingleAnswerScoring <<ConcreteStrategy>>
    class MultiAnswerAllOrNothing <<ConcreteStrategy>>
    class MultiAnswerPartialScoring <<ConcreteStrategy>>
    class ScoringInput <<record>>
    class QuestionScore <<record>>
  }
}

