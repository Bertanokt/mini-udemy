@startuml class
' UML sınıf diyagramı — genel bakış: 10 modülün domain ve service katmanı (#51).
' Modüller ModuleArchitectureTest.ALLOWED ile aynı. Domain sınıfları alanları ve iş metotlarıyla (getter ve
' yapıcılar gösterilmez); service paketleri yalnız sınıf adlarıyla. Desenlerin ayrıntısı ayrı diyagramlarda:
'   class-state.puml (ADR-010), class-observer.puml (ADR-009), class-strategy.puml (ADR-008),
'   class-factory.puml (ADR-011), class-dto-mapper.puml (ADR-006).
' Sınıf, alan ve metot adları koddakiyle birebir; tutarlılık tablosu PR #51'de.
' Render (Graphviz gerekmez, smetana yerleşimi; PNG ve SVG ayrı komutlarla):
'   java -DPLANTUML_LIMIT_SIZE=16384 -Duser.language=en -Duser.country=US -jar plantuml.jar -tpng docs/diagrams/class.puml
'   java -DPLANTUML_LIMIT_SIZE=16384 -Duser.language=en -Duser.country=US -jar plantuml.jar -tsvg docs/diagrams/class.puml

!pragma layout smetana
!include class-style.iuml
' Soldan sağa yerleşim: smetana modülleri yukarıdan aşağı dizdiğinde diyagram ~11000 px genişliyordu.
left to right direction

title Mini Udemy - Sınıf diyagramı: genel bakış (domain + service, 10 modül)

legend top left
  <b>Gösterim</b>
  düz ok / kompozisyon: JPA ilişkisi (@ManyToOne, @OneToMany, @ElementCollection)
  kesikli ok "alan": modül sınırında id ile referans (entity'ye erişilmez, ADR-001)
  kesikli üçgen: modülün tanımladığı arayüzü başka modül uygular
  <<State>> / <<Strategy>> / <<Creator>> / <<event>> / <<listener>>: desen rolü,
  ayrıntı class-state / class-strategy / class-factory / class-observer diyagramlarında
  DTO + Mapper: class-dto-mapper. Getter'lar ve yapıcılar gösterilmez.
endlegend

' ================= auth =================
package "com.miniudemy.auth" as auth {
  package "auth.domain" {
    class User <<entity>> {
      - id : Long
      - email : String
      - passwordHash : String
      - fullName : String
      - bio : String
      - role : Role
      - active : boolean = true
      - createdAt : Instant
      - updatedAt : Instant
      + setActive(active : boolean) : void
      + updateProfile(fullName : String, bio : String) : void
      + changePasswordHash(passwordHash : String) : void
    }
    class PasswordResetToken <<entity>> {
      - id : Long
      - userId : Long
      - tokenHash : String
      - expiresAt : Instant
      - usedAt : Instant
      - createdAt : Instant
      + isUsableAt(now : Instant) : boolean
    }
    enum Role {
      STUDENT
      INSTRUCTOR
      ADMIN
    }
  }
  package "auth.service" {
    class AccountLookupService
    class AuthService
    class ProfileService
    class PasswordResetService
    interface PasswordResetNotifier {
      + sendResetLink(email : String, resetLink : String, expiresAt : Instant) : void
    }
    class LoggingPasswordResetNotifier <<dev>>
    class DisabledPasswordResetNotifier <<!dev>>
    class UserAccountService
    class UserDirectoryService
    class UserStatsService
  }
}

' ================= course =================
package "com.miniudemy.course" as course {
  package "course.domain" {
    class Category <<entity>> {
      - id : Long
      - name : String
      - createdAt : Instant
      + rename(name : String) : void
    }
    class Course <<entity>> <<Context>> {
      - id : Long
      - instructorId : Long
      - category : Category
      - coverFileId : Long
      - title : String
      - description : String
      - level : CourseLevel
      - learningOutcomes : List<String>
      - status : CourseStatus = CourseStatus.DRAFT
      - rejectionReason : String
      - unpublishReason : String
      - createdAt : Instant
      - updatedAt : Instant
      - sections : List<Section>
      + addSection(section : Section) : void
      + appendSection(title : String) : Section
      + removeSection(section : Section) : void
      + moveSection(section : Section, newPosition : int) : void
      + getTotalDurationSeconds() : int
      + replaceCover(fileId : Long) : Long
      + update(category : Category, title : String, description : String, level : CourseLevel, learningOutcomes : List<String>) : void
      + attachedFileIds() : List<Long>
      + isPublished() : boolean
      + assertEditable() : void
      + assertLessonAddable() : void
      + assertContentUploadable(lesson : Lesson) : void
      + assertDeletable() : void
      + submit() : void
      + approve() : void
      + reject(reason : String) : void
      + unpublish(reason : String) : void
    }
    class Section <<entity>> {
      - id : Long
      - course : Course
      - title : String
      - position : int
      - createdAt : Instant
      - lessons : List<Lesson>
      + addLesson(lesson : Lesson) : void
      + rename(title : String) : void
      + removeLesson(lesson : Lesson) : void
      + moveLesson(lesson : Lesson, newPosition : int) : void
      + getTotalDurationSeconds() : int
    }
    class Lesson <<entity>> {
      - id : Long
      - section : Section
      - contentFileId : Long
      - title : String
      - contentType : LessonContentType
      - mandatory : boolean = true
      - durationSeconds : int
      - position : int
      - createdAt : Instant
      - updatedAt : Instant
      + update(title : String, contentType : LessonContentType, mandatory : boolean, durationSeconds : int) : void
      + replaceContent(fileId : Long) : Long
    }
    enum CourseStatus
    enum CourseLevel {
      BEGINNER
      INTERMEDIATE
      ADVANCED
    }
    enum LessonContentType {
      VIDEO
      PDF
      DOCUMENT
    }
    interface CourseState <<sealed>> <<State>>
    class DraftState <<ConcreteState>>
    class InReviewState <<ConcreteState>>
    class PublishedState <<ConcreteState>>
    class UnpublishedState <<ConcreteState>>
    class CourseStateException
    class CourseApproved <<event>>
    class CourseRejected <<event>>
    class LessonPublished <<event>>
    class CourseLessonsChanged <<event>>
    class ContentFileDetached <<event>>
  }
  package "course.service" {
    class CategoryService
    class ContentLinkService
    class CourseAnalyticsService
    class CourseCatalogService
    class CourseLifecycleService
    class CourseLookupService
    class CourseOwnershipService
    class CoursePlatformStatsService
    class CourseService
    class CourseStructureService
    class CourseVisibility
    class LessonLookupService
    class LessonService
    class SectionService
    enum CatalogSort
    class CourseRating <<record>>
    interface CourseRoster
    interface EnrollmentCounts
    interface CourseProgressStats
    interface CourseQuizStats
    interface CourseRatings
  }
}

